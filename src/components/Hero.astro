---
---

<section
	id="home"
	class="relative w-full overflow-hidden min-h-screen lg:h-screen pt-24 lg:pt-0 px-6 lg:px-10"
>
	<!-- Fondo azul con luz -->
	<div class="absolute inset-0 -z-30 bg-brand-blue-deep"></div>
	<div
		class="absolute inset-0 -z-20 opacity-70"
		style="background-image: radial-gradient(circle at 15% 20%, rgba(60,47,135,.9), transparent 55%), radial-gradient(circle at 85% 75%, rgba(210,37,16,.35), transparent 50%);"
	>
	</div>

	<div
		class="relative w-full max-w-[1600px] mx-auto min-h-[calc(100vh-6rem)] lg:h-full flex flex-col gap-8 lg:gap-0 lg:block group"
	>
		<!-- TÍTULO gigante (detrás de la mujer en desktop) -->
		<h1
			data-hero-title
			class="font-display font-black leading-[0.85] tracking-tight text-white select-none opacity-0 z-10 lg:absolute lg:inset-x-0 lg:top-1/2 lg:-translate-y-1/2 2xl:top-2/5 lg:pointer-events-none group-hover:scale-95 transition-all duration-300 ease-in-out"
			style="font-size: clamp(2.75rem, 16vw, 15.5rem);"
		>
			<span class="block">Cabello</span>
			<span class="block text-right text-white/40">Sano.</span>
		</h1>

		<!-- COPY + botones (al frente, bottom-left en desktop) -->
		<div
			class="max-w-sm text-sm lg:text-base text-white/90 leading-relaxed z-30 lg:absolute lg:bottom-20 text-center lg:text-left lg:left-0 mx-auto lg:mx-0"
			data-reveal="fade-up"
			data-reveal-delay="0.6"
		>
			<p>
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
				tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
				veniam, quis nostrud exercitation.
			</p>

			<div class="mt-6 flex flex-wrap justify-center lg:justify-start items-center gap-4">
				<a
					href="#productos"
					class="inline-flex items-center px-6 py-3 rounded-full bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold tracking-widest uppercase transition-colors"
				>
					Ver producto
				</a>
				<a
					href="#nosotros"
					class="inline-flex items-center px-6 py-3 rounded-full border border-white/30 hover:bg-white/10 text-white text-xs font-bold tracking-widest uppercase transition-colors"
				>
					Conocer más
				</a>
			</div>
		</div>

		<!-- MUJER (centrada, cubre el título — z-20 la deja entre texto y copy) -->
		<div
			class="flex items-end justify-center z-20 lg:absolute lg:inset-0 group-hover:scale-102 group-hover:-translate-y-2 transition-all duration-300 ease-in-out"
		>
			<img
				src="/images/mujer.png"
				alt=""
				aria-hidden="true"
				class="max-h-[45vh] sm:max-h-[55vh] md:max-h-[65vh] lg:h-full lg:max-h-[55vh] w-auto object-contain object-bottom pointer-events-none select-none"
				data-reveal="fade-up"
				data-reveal-delay="0.3"
			/>
		</div>
	</div>
</section>
