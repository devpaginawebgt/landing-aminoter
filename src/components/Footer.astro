---
const contacto = [
	{ label: "soporte@lab-lafage.com", href: "mailto:soporte@lab-lafage.com" },
	{ label: "WhatsApp · +502 9999-9999", href: "https://wa.me/50299999999" },
	{ label: "Instagram · @aminoter", href: "https://instagram.com/aminoter" },
];

const year = new Date().getFullYear();
---

<footer id="contacto" class="relative w-full bg-cream text-brand-blue-deep">
	<div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 border-t border-brand-blue-deep/15">
		<div
			class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start"
		>
			<!-- IZQUIERDA: logo + tagline -->
			<div class="flex flex-col gap-6">
				<img
					src="/images/AMINOTER.png"
					alt="Aminoter"
					class="h-16 lg:h-20 w-auto object-contain self-start"
				/>
				<p
					class="text-brand-blue-deep/60 text-base lg:text-lg leading-relaxed max-w-md"
				>
					Ciencia al servicio de tu cabello.
				</p>
			</div>

			<!-- DERECHA: contacto -->
			<div class="flex flex-col gap-3 lg:items-end">
				<p
					class="text-xs font-bold tracking-[0.3em] uppercase text-brand-blue-deep mb-2"
				>
					Contacto
				</p>
				{
					contacto.map((c) => (
						<a
							href={c.href}
							class="text-sm lg:text-base text-brand-blue-deep/80 hover:text-brand-red transition-colors"
						>
							{c.label}
						</a>
					))
				}
			</div>
		</div>

		<!-- Separador -->
		<div class="mt-16 lg:mt-20 pt-8 border-t border-brand-blue-deep/15">
			<div
				class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs tracking-[0.2em] uppercase text-brand-blue-deep/50"
			>
				<p>© {year} Aminoter</p>
				<p>Hecho con cuidado. Formulado con ciencia.</p>
			</div>
		</div>
	</div>
</footer>
