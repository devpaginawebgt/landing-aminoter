---
const links = [
	{ label: "Inicio", href: "#home" },
	{ label: "Nosotros", href: "#nosotros" },
	{ label: "Productos", href: "#productos" },
	{ label: "Blog", href: "#blog" },
];
---

<header
	id="site-header"
	data-reveal="fade-down"
	class="fixed top-0 left-0 right-0 z-50 isolate flex items-center justify-between px-6 md:px-10 transition-[box-shadow,padding] duration-300 ease-out"
>
	<span
		id="site-header-bg"
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 -z-10 origin-center scale-x-0 bg-brand-blue-deep transition-transform duration-600 ease-[cubic-bezier(0.22,1,0.36,1)]"
	></span>

	<a href="/" class="flex items-center">
		<img
			src="/images/AMINOTER-BLANCO.png"
			alt="Aminoter"
			class="h-8 md:h-10 w-auto"
		/>
	</a>

	<nav class="hidden md:flex items-stretch gap-4">
		{
			links.map((link) => (
				<a
					href={link.href}
					class="inline-block text-xs font-bold tracking-widest uppercase text-white/80 hover:text-white hover:-translate-y-0.5 transition-all duration-300 ease-out p-2"
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<a
		href="#contacto"
		class="hidden md:inline-flex items-center px-5 py-2.5 rounded-full bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold tracking-widest uppercase transition-colors"
	>
		Comprar
	</a>
</header>

<script>
	const header = document.getElementById("site-header");
	const headerBg = document.getElementById("site-header-bg");
	if (header && headerBg) {
		const scrolledClasses = ["shadow-sm", "py-4"];
		const topClasses = ["py-5"];

		const update = () => {
			const isScrolled = window.scrollY > 20;
			header.classList.toggle("is-scrolled", isScrolled);
			for (const c of scrolledClasses) header.classList.toggle(c, isScrolled);
			for (const c of topClasses) header.classList.toggle(c, !isScrolled);
			headerBg.classList.toggle("scale-x-0", !isScrolled);
			headerBg.classList.toggle("scale-x-100", isScrolled);
		};

		update();
		window.addEventListener("scroll", update, { passive: true });
	}
</script>
