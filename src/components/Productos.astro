---
const productos = [
	{
		tag: "01 — Cuidado diario",
		title: "Aminoter",
		desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
		img: "/images/producto_aminoter.png",
	},
	{
		tag: "02 — Nutrición avanzada",
		title: "Aminoter Complex",
		desc: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
		img: "/images/producto_aminoter_complex.png",
	},
	{
		tag: "03 — Fórmula intensiva",
		title: "Aminoter MAX",
		desc: "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
		img: "/images/producto_aminoter_max.png",
	},
];
---

<section id="productos" class="relative bg-brand-blue-deep">
	{/* ─────────── MOBILE: cards apiladas ─────────── */}
	<div class="lg:hidden">
		{
			productos.map((p) => (
				<div class="px-6 py-20 border-b border-white/5 last:border-b-0">
					<div class="max-w-md mx-auto flex flex-col gap-6">
						<img
							src={p.img}
							alt={p.title}
							class="w-full max-w-xs sm:max-w-md mx-auto object-contain drop-shadow-2xl"
						/>
						<p class="text-xs font-bold tracking-[0.3em] uppercase text-brand-red">
							{p.tag}
						</p>
						<h2 class="font-display font-black leading-[0.9] tracking-tight text-white text-4xl">
							{p.title}
						</h2>
						<p class="text-white/70 leading-relaxed">{p.desc}</p>
						<a
							href="#"
							class="group inline-flex items-center gap-3 self-start px-8 py-4 rounded-full bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold tracking-widest uppercase transition-colors"
						>
							Ver detalle
							<span
								aria-hidden="true"
								class="transition-transform group-hover:translate-x-1"
							>
								→
							</span>
						</a>
					</div>
				</div>
			))
		}
	</div>

	{/* ─────────── DESKTOP: scroll-swap con pin ─────────── */}
	<div data-products class="hidden lg:block h-[300vh]">
		<div
			data-products-pin
			class="relative h-screen w-full overflow-hidden flex items-center px-10"
		>
			<div
				class="w-full pt-16 max-w-350 mx-auto grid grid-cols-2 gap-16 2xl:gap-4 items-center"
			>
				{/* Columna izquierda: 3 textos apilados en su propio contenedor */}
				<div class="relative h-[70vh] overflow-hidden">
					{
						productos.map((p, i) => (
							<div
								data-product-text
								data-product-index={i}
								class:list={[
									"absolute inset-0 flex flex-col justify-center gap-6",
									i > 0 && "translate-y-full",
								]}
							>
								<p class="text-xs 2xl:text-sm font-bold tracking-[0.3em] uppercase text-brand-red">
									{p.tag}
								</p>
								<h2
									class="font-display font-black leading-[0.9] tracking-tight text-white"
									style="font-size: clamp(2.5rem, 5vw, 4.5rem);"
								>
									{p.title}
								</h2>
								<p class="text-white/80 text-lg 2xl:text-xl leading-relaxed max-w-md">
									{p.desc}
								</p>
								<a
									href="#"
									class="mt-4 group inline-flex items-center gap-3 self-start px-8 py-4 rounded-full bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold tracking-widest uppercase transition-colors"
								>
									Ver detalle
									<span
										aria-hidden="true"
										class="transition-transform group-hover:translate-x-1"
									>
										→
									</span>
								</a>
							</div>
						))
					}
				</div>

				{/* Columna derecha: 3 imágenes apiladas en su propio contenedor */}
				<div class="relative h-[70vh] overflow-hidden">
					{
						productos.map((p, i) => (
							<div
								data-product-image
								data-product-index={i}
								class:list={[
									"absolute inset-0 flex items-center justify-center",
									i > 0 && "-translate-y-full",
								]}
							>
								<img
									src={p.img}
									alt={p.title}
									class="w-full max-w-md xl:max-w-lg 2xl:max-w-xl h-auto object-contain drop-shadow-2xl"
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
