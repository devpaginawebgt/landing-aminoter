---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Aminoter — Cuidado real para tu cabello",
	description = "Shampoo formulado con activos que fortalecen, hidratan y revitalizan tu cabello desde la raíz.",
} = Astro.props;

const noindex = import.meta.env.PUBLIC_NOINDEX === "true";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body class="antialiased">
		<slot />
		<script>
			import { initSmoothScroll } from "../scripts/smoothScroll";
			import { initAnimations } from "../scripts/animations";

			initSmoothScroll();
			initAnimations();
		</script>
	</body>
</html>
